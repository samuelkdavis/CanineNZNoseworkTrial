{
    "scripts": {
        "start:frontend": "npm run dev --prefix frontend",
        "dev:install-frontend": "npm install --prefix frontend",
        "dev:install-backend": "dotnet build api/Nosework/Nosework.sln",
        "start:backend": "dotnet run --project api/Nosework/Nosework.Api/Nosework.Api.csproj",
        "start": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\""
    },
    "devDependencies": {
        "concurrently": "^9.2.0"
    }
}